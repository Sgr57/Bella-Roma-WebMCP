    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
