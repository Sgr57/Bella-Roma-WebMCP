{
  "name": "@local/imagegen",
  "private": true,
  "version": "0.1.0",
  "description": "Agnostic image generation utility on top of Cloudflare Workers AI (Flux). Drop-in, project-independent.",
  "type": "module",
  "main": "./src/index.ts",
  "bin": {
